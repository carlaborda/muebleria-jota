# Copiar a backend/.env y completar. Nunca subir .env al repositorio.

# Cadena de conexión de MongoDB (obligatoria).
# Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/muebleria-jota
# Local: mongodb://127.0.0.1:27017/muebleria-jota
MONGO_URI=

# Puerto de la API. Render lo define solo.
PORT=3000

# Orígenes del front habilitados por CORS, separados por coma.
# Solo hace falta en producción. Ej: https://muebleria-jota.vercel.app
CORS_ORIGIN=
